<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="co.edu.uniquindio.poo.controladores.ControladorCompras"
            prefWidth="950"
            prefHeight="650">

    <top>
        <VBox spacing="8" style="-fx-background-color: #20232a;">
            <padding>
                <Insets top="20" right="25" bottom="20" left="25"/>
            </padding>

            <Label text="MI HISTORIAL DE COMPRAS"
                   style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>

            <Label text="Consulta tus compras de entradas y confitería"
                   style="-fx-text-fill: #cccccc;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="15">
            <padding>
                <Insets top="25" right="30" bottom="25" left="30"/>
            </padding>

            <Label text="Compras realizadas"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <TableView fx:id="tablaCompras"
                       VBox.vgrow="ALWAYS">

                <columns>
                    <TableColumn fx:id="colId"
                                 text="ID de compra"
                                 prefWidth="200"/>

                    <TableColumn fx:id="colFecha"
                                 text="Fecha"
                                 prefWidth="200"/>

                    <TableColumn fx:id="colTotal"
                                 text="Total"
                                 prefWidth="150"/>
                </columns>

            </TableView>

            <Label text="Detalle de la compra"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <ListView fx:id="listaDetalles"
                      prefHeight="160"/>

        </VBox>
    </center>

    <bottom>
        <HBox spacing="15"
              alignment="CENTER_RIGHT"
              style="-fx-background-color: #eeeeee;">

            <padding>
                <Insets top="15" right="30" bottom="15" left="30"/>
            </padding>

            <Button text="Actualizar"
                    onAction="#actualizarCompras"/>

            <Button text="Volver"
                    onAction="#volver"/>

        </HBox>
    </bottom>

</BorderPane>