<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.poo.controladores.ControladorReportes"
      stylesheets="@../estilos/estilos.css"
      styleClass="fondo"
      spacing="18">

    <padding>
        <Insets top="25" right="30" bottom="25" left="30"/>
    </padding>

    <Label text="Reportes y estadísticas"
           styleClass="titulo-contenido"/>

    <Label text="Resumen de las ventas registradas en CinemaUQ"
           styleClass="subtitulo"/>

    <HBox spacing="30">

        <VBox spacing="8">
            <Label text="Compras pagadas"/>
            <Label fx:id="lblComprasPagadas"
                   text="0"
                   styleClass="titulo-contenido"/>
        </VBox>

        <VBox spacing="8">
            <Label text="Ingresos totales"/>
            <Label fx:id="lblIngresosTotales"
                   text="0 COP"
                   styleClass="titulo-contenido"/>
        </VBox>

    </HBox>

    <Label text="Entradas vendidas por película"
           styleClass="titulo-menu"/>

    <BarChart fx:id="graficoVentas"
              title="Ventas por película"
              animated="false"
              VBox.vgrow="ALWAYS">

        <xAxis>
            <CategoryAxis label="Película"/>
        </xAxis>

        <yAxis>
            <NumberAxis label="Entradas vendidas"
                        forceZeroInRange="true"
                        tickUnit="1"/>
        </yAxis>

    </BarChart>

    <HBox spacing="12">

        <Button text="Actualizar estadísticas"
                onAction="#actualizarEstadisticas"
                styleClass="boton-menu"/>

        <Button text="Exportar reporte TXT"
                onAction="#exportarReporte"
                styleClass="boton-menu"/>

    </HBox>

</VBox>
